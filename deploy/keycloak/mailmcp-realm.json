{
  "realm": "mailmcp",
  "displayName": "MailMCP",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(14) and notUsername(undefined) and notEmail(undefined)",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "es"],
  "defaultLocale": "en",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "clientScopes": [
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mailmcp",
      "description": "Manage your own connected email accounts and mail",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Manage your connected email accounts, messages and attachments"
      },
      "protocolMappers": [
        {
          "name": "mailmcp audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "${MAILMCP_PUBLIC_URL}/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "basic",
      "description": "Standard OIDC subject claim for dynamic clients",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mailmcp-web",
      "name": "MailMCP web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "consentRequired": false,
      "redirectUris": ["${MAILMCP_PUBLIC_URL}/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": ["profile"],
      "optionalClientScopes": []
    },
    {
      "clientId": "mailmcp-mcp",
      "name": "MailMCP mcp",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "consentRequired": true,
      "redirectUris": ["http://127.0.0.1:8765/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": ["profile"],
      "optionalClientScopes": ["mailmcp"]
    }
  ],
  "defaultDefaultClientScopes": ["basic"],
  "defaultOptionalClientScopes": ["profile", "mailmcp"],
  "clientProfiles": {
    "profiles": [
      {
        "name": "mailmcp-dcr",
        "description": "MCP dynamic clients: PKCE, consent, constrained redirects and no server-side client URLs.",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": {
              "auto-configure": true
            }
          },
          {
            "executor": "consent-required",
            "configuration": {
              "auto-configure": true
            }
          },
          {
            "executor": "full-scope-disabled",
            "configuration": {
              "auto-configure": true
            }
          },
          {
            "executor": "reject-implicit-grant",
            "configuration": {
              "auto-configure": true
            }
          },
          {
            "executor": "reject-ropc-grant",
            "configuration": {
              "auto-configure": true
            }
          },
          {
            "executor": "secure-redirect-uris-enforcer",
            "configuration": {
              "allow-ipv4-loopback-address": true,
              "allow-ipv6-loopback-address": true,
              "allow-http-scheme": true,
              "allow-wildcard-context-path": false,
              "allow-private-use-uri-scheme": false,
              "oauth-2-0-compliant": true
            }
          },
          {
            "executor": "secure-client-uris-pattern",
            "configuration": {
              "client-uri-fields": ["redirectUris", "postLogoutRedirectUris"],
              "allowed-patterns": [
                "https://[^/@#*\\s]+(?:/[^#*\\s]*)?",
                "http://(?:127\\.0\\.0\\.1|localhost|\\[::1\\])(?::[0-9]{1,5})?(?:/[^#*\\s]*)?"
              ]
            }
          }
        ]
      },
      {
        "name": "mailmcp-dcr-no-fetch",
        "description": "Dynamic clients may not cause Keycloak to fetch remote key, request or callback URLs.",
        "executors": [
          {
            "executor": "secure-client-uris-pattern",
            "configuration": {
              "client-uri-fields": [
                "rootUrl",
                "adminUrl",
                "jwksUri",
                "requestUris",
                "backchannelLogoutUrl",
                "cibaClientNotificationEndpoint",
                "sectorIdentifierUri"
              ],
              "allowed-patterns": []
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "mailmcp-dcr",
        "description": "Enforce safe dynamic registration and subsequent registration-token updates.",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-updater-context",
            "configuration": {
              "update-client-source": [
                "ByAnonymous",
                "ByRegistrationAccessToken",
                "ByInitialAccessToken"
              ]
            }
          }
        ],
        "profiles": ["mailmcp-dcr", "mailmcp-dcr-no-fetch"]
      }
    ]
  },
  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Consent Required",
        "providerId": "consent-required",
        "subType": "anonymous",
        "config": {}
      },
      {
        "name": "Full Scope Disabled",
        "providerId": "scope",
        "subType": "anonymous",
        "config": {}
      },
      {
        "name": "Max Clients Limit",
        "providerId": "max-clients",
        "subType": "anonymous",
        "config": {
          "max-clients": ["200"]
        }
      },
      {
        "name": "Allowed Client Scopes",
        "providerId": "allowed-client-templates",
        "subType": "anonymous",
        "config": {
          "allow-default-scopes": ["false"],
          "allowed-client-scopes": ["openid", "profile", "mailmcp", "basic"]
        }
      },
      {
        "name": "Allowed Protocol Mapper Types",
        "providerId": "allowed-protocol-mappers",
        "subType": "anonymous",
        "config": {
          "allowed-protocol-mapper-types": []
        }
      },
      {
        "name": "Allowed Registration Web Origins",
        "providerId": "registration-web-origins",
        "subType": "anonymous",
        "config": {}
      }
    ]
  }
}
