MAILMCP_MODE=local
# Default language for stdio MCP and HTTP requests without a supported language.
MAILMCP_LANGUAGE=en
# Generate a random encryption key with npm run setup. Never commit .env.
MAILMCP_MASTER_KEY=
MAILMCP_DATA_DIR=./data
MAILMCP_WEB_PORT=3210
# '*' allows every public mail provider; private/reserved IPs remain blocked.
# Alternatively use comma-separated exact hostnames. Empty blocks all mail hosts.
MAILMCP_ALLOWED_HOSTS=*

# Hosted mode requires all of these (see docs/HOSTING.md):
# MAILMCP_PUBLIC_URL=https://mail.example.com
# MAILMCP_DOMAIN=mail.example.com
# MAILMCP_BIND=0.0.0.0
# MAILMCP_OIDC_ISSUER=https://identity.example.com
# MAILMCP_OIDC_CLIENT_ID=mailmcp-web
# MAILMCP_OIDC_CLIENT_SECRET=
# MAILMCP_OAUTH_SCOPE=mailmcp
